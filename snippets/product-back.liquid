<button
  type="button"
  class="product-back"
  data-product-back
>
  {% render 'icon-arrow', direction: 'left' %}
  <span>{{ 'products.product.back' | t }}</span>
</button>

<script>
  if (!window.__productBackBound) {
    window.__productBackBound = true;
    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-product-back]');
      if (!button) return;
      event.preventDefault();
      window.history.back();
    });
  }
</script>
